{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "repair:scraped-entities": "tsx src/scripts/repairScrapedEntities.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@clerk/express": "^2.1.35",
    "@clerk/shared": "^4.23.0",
    "@google-cloud/storage": "7.21.0",
    "@replit/object-storage": "^1.0.0",
    "@types/nodemailer": "^8.0.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "http-proxy-middleware": "^4.2.0",
    "libphonenumber-js": "^1.12.29",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "stripe": "^18.0.0",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.4",
    "thread-stream": "3.1.0",
    "vitest": "^3.2.4"
  }
}
