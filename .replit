modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
# Runs during the deploy, in the deployment's own environment — so
# DATABASE_URL here is the PRODUCTION database the deployed app actually
# reads. Applying the Drizzle schema here means every Republish migrates
# prod automatically, instead of it silently drifting behind the code
# (which is what left production missing visitor_sessions / whisp_sender_handles
# / sms_consents and new columns, surfacing as "Whisp not found", empty live
# visitors, and frozen last-seen). `db push` is idempotent: a no-op when the
# schema already matches. Kept before the store prune so a migration failure
# fails the deploy loudly rather than shipping code against an un-migrated DB.
args = ["sh", "-c", "pnpm --filter @workspace/db run push && pnpm store prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/whispick: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/whispick"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/blindwhisper run dev"
cwd = "./artifacts/blindwhisper"
waitForPort = 22964
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "22964"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "parallel"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[objectStorage]
defaultBucketID = "replit-objstore-3806b3a1-14a4-4008-b15c-d7f371ab4592"
